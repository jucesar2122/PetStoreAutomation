{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanPruebasResumen",
  "type": "object",
  "required": [
    "proyecto",
    "modulo",
    "fecha",
    "documento_fuente",
    "alcance",
    "riesgos",
    "criterios_salida",
    "metricas"
  ],
  "properties": {
    "proyecto": {
      "type": "string"
    },
    "modulo": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "documento_fuente": {
      "type": "object",
      "required": [
        "nombre",
        "version"
      ],
      "properties": {
        "nombre": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "calendario_declarado": {
      "type": "boolean"
    },
    "recursos_declarados": {
      "type": "boolean"
    },
    "alcance": {
      "type": "object",
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "modulo",
              "descripcion",
              "fuente_cita"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SCP-\\d{2}$"
              },
              "modulo": {
                "type": "string"
              },
              "descripcion": {
                "type": "string"
              },
              "fuente_cita": {
                "type": "string"
              }
            }
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "elemento",
              "justificacion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OOS-\\d{2}$"
              },
              "elemento": {
                "type": "string"
              },
              "justificacion": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "riesgos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "descripcion",
          "categoria",
          "probabilidad",
          "impacto",
          "nivel",
          "mitigacion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RSK-\\d{2}$"
          },
          "descripcion": {
            "type": "string"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "Técnico",
              "Negocio",
              "Operativo",
              "Alcance"
            ]
          },
          "probabilidad": {
            "type": "string",
            "enum": [
              "Alta",
              "Media",
              "Baja"
            ]
          },
          "impacto": {
            "type": "string",
            "enum": [
              "Alto",
              "Medio",
              "Bajo"
            ]
          },
          "nivel": {
            "type": "string",
            "enum": [
              "Crítico",
              "Alto",
              "Medio",
              "Bajo"
            ]
          },
          "mitigacion": {
            "type": "string"
          }
        }
      }
    },
    "criterios_salida": {
      "type": "object",
      "required": [
        "porcentaje_ejecucion_alta",
        "porcentaje_aprobacion_total",
        "defectos_criticos_permitidos"
      ],
      "properties": {
        "porcentaje_ejecucion_alta": {
          "type": "number",
          "minimum": 100,
          "maximum": 100
        },
        "porcentaje_aprobacion_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "defectos_criticos_permitidos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        }
      }
    },
    "metricas": {
      "type": "object",
      "required": [
        "total_in_scope",
        "total_out_of_scope",
        "total_riesgos",
        "riesgos_criticos"
      ],
      "properties": {
        "total_in_scope": {
          "type": "integer"
        },
        "total_out_of_scope": {
          "type": "integer"
        },
        "total_riesgos": {
          "type": "integer"
        },
        "riesgos_criticos": {
          "type": "integer"
        }
      }
    }
  }
}