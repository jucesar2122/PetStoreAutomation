{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EjecucionResumen",
  "type": "object",
  "required": [
    "proyecto",
    "perfil",
    "fecha_inicio",
    "duracion_segundos",
    "entorno",
    "metricas",
    "resultados_casos",
    "listo_para_reporte"
  ],
  "properties": {
    "proyecto": {
      "type": "string"
    },
    "perfil": {
      "type": "string"
    },
    "fecha_inicio": {
      "type": "string"
    },
    "duracion_segundos": {
      "type": "number"
    },
    "entorno": {
      "type": "string"
    },
    "metricas": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "flaky",
        "skipped",
        "pass_rate"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "flaky": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "resultados_casos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id_caso",
          "estado",
          "duracion_ms",
          "intentos"
        ],
        "properties": {
          "id_caso": {
            "type": "string",
            "pattern": "^TC-\\d{3}$"
          },
          "estado": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "FLAKY",
              "SKIPPED"
            ]
          },
          "duracion_ms": {
            "type": "number"
          },
          "intentos": {
            "type": "integer"
          },
          "error_mensaje": {
            "type": "string"
          },
          "evidencia_path": {
            "type": "string"
          }
        }
      }
    },
    "listo_para_reporte": {
      "type": "boolean"
    }
  }
}